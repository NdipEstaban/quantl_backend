	float h = high
	float l = low
	float c = close
	float v = volume
	int i = bar_index

type barData
	array<float> bh
	array<float> bl
	array<float> bv
	array<bool> bp
	array<int> bn

type volData
	array<float> vt
	array<float> vb
	array<float> vd

type tVP
	array<box> vp
	array<chart.point> pPC
	polyline dPC
	int pcL
	int laP
	int lbP
	int sI

type tVH
	array<line> vh
	array<chart.point> pMA
	polyline vMA

